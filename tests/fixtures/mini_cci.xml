<?xml version="1.0" encoding="utf-8"?>
<!--
  Test fixture: a four-entry subset of DISA's U_CCI_List.xml.

  GENERATED FROM THE REAL LIST, not hand-written. Every reference below is
  copied verbatim from the published CCI list so the fixture cannot assert a
  mapping that does not exist.

  The set is chosen to exercise the revision-selection logic in load_cci_map():
  two ordinary CCIs present in every revision, one CCI retired after Rev 4, and
  the Rev 5 successor that replaced it. Asked for revision 5, the retired entry must
  contribute nothing and the successor must supply the control.
-->
<cci_list xmlns="http://iase.disa.mil/cci">
  <cci_items>
    <!-- present in every revision, the ordinary case -->
    <cci_item id="CCI-000366">
      <definition>Implement the security configuration settings.</definition>
      <references>
        <reference creator="NIST" title="NIST SP 800-53" version="3" index="CM-6 b" />
        <reference creator="NIST" title="NIST SP 800-53A" version="1" index="CM-6.1 (iv)" />
        <reference creator="NIST" title="NIST SP 800-53 Revision 4" version="4" index="CM-6 b" />
        <reference creator="NIST" title="NIST SP 800-53 Revision 5" version="5" index="CM-6 b" />
      </references>
    </cci_item>
    <!-- present in every revision -->
    <cci_item id="CCI-000048">
      <definition>Display an organization-defined system use notification message or banner to users before granting access to the system that provides privacy and security notices consistent with applicable federal laws, Executive Orders, directives, policies, regulations, standards, and guidelines.</definition>
      <references>
        <reference creator="NIST" title="NIST SP 800-53" version="3" index="AC-8 a" />
        <reference creator="NIST" title="NIST SP 800-53A" version="1" index="AC-8.1 (ii)" />
        <reference creator="NIST" title="NIST SP 800-53 Revision 4" version="4" index="AC-8 a" />
        <reference creator="NIST" title="NIST SP 800-53 Revision 5" version="5" index="AC-8 a" />
      </references>
    </cci_item>
    <!-- RETIRED after Rev 4. No Rev 5 reference exists. -->
    <cci_item id="CCI-000795">
      <definition>The organization manages information system identifiers by disabling the identifier after an organization-defined time period of inactivity.</definition>
      <references>
        <reference creator="NIST" title="NIST SP 800-53" version="3" index="IA-4 e" />
        <reference creator="NIST" title="NIST SP 800-53A" version="1" index="IA-4.1 (iii)" />
        <reference creator="NIST" title="NIST SP 800-53 Revision 4" version="4" index="IA-4 e" />
      </references>
    </cci_item>
    <!-- the Rev 5 successor to CCI-000795. Rev 5 only. -->
    <cci_item id="CCI-003627">
      <definition>Disable accounts when the accounts have expired.</definition>
      <references>
        <reference creator="NIST" title="NIST SP 800-53 Revision 5" version="5" index="AC-2 (3) (a)" />
      </references>
    </cci_item>
  </cci_items>
</cci_list>
